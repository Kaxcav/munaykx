# Copie para .env e ajuste se necessário.
# Postgres local via docker-compose (docker compose up -d).
# Porta 5434 no host — 5432/5433 já pertencem a Postgres de outros projetos.
DATABASE_URL="postgresql://munay:munay@localhost:5434/munay"

# Analytics (Umami self-host no Railway) — opcionais: sem elas o site sobe
# normalmente, só não carrega o script. Ver README, seção "Analytics (Umami)".
# NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://<serviço-umami>.up.railway.app/script.js"
# NEXT_PUBLIC_UMAMI_WEBSITE_ID="<uuid do site no painel do Umami>"

# Admin interno (/admin, STORY-005). Sem estas envs a rota responde 503 —
# não existe senha default. Em produção, use uma senha longa e única.
# ADMIN_USER="munay"
# ADMIN_PASSWORD="troque-por-uma-senha-longa"
