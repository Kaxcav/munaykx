generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadTipo {
  participante
  organizador
}

model Lead {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  tipo        LeadTipo
  nome        String
  email       String
  whatsapp    String?
  modalidades String?
  regiao      String?
  organizacao String?
  modalidade  String?
  origem      String   @default("site")

  @@unique([email, tipo])
  @@map("leads")
}

model Community {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @map("created_at")
  slug       String   @unique
  nome       String
  modalidade String
  regiao     String
  // Multi-cidade no dado, não no código (Blueprint C1). Sem UI de seletor
  // ainda — as queries de descoberta filtram pelo default.
  city       String   @default("Brasília")
  descricao  String?
  horarios   String?
  local      String?
  nivel      String?
  demo       Boolean  @default(false)
  ativo      Boolean  @default(true)
  events     Event[]

  // ── Organização dona (STORY-009) ─────────────────────────────────────
  // `null` = cadastrada por nós pelo /admin. Continua existindo e sendo
  // editável só pelo admin interno.
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Default `aprovada` DE PROPÓSITO, não `pendente`: as comunidades que já
  // estão em produção foram cadastradas por nós e não podem sumir do site
  // no instante do deploy. Quem nasce pendente é só o que vem pelo painel,
  // e isso é decidido na aplicação — nunca no default da coluna.
  statusPublicacao StatusPublicacao @default(aprovada) @map("status_publicacao")

  // A PROVA da regra 3 do projeto: o texto exato que o organizador aceitou
  // e quando. Não é telemetria — é o documento que autoriza publicar o nome
  // de um parceiro real. Guardar o texto, e não só um booleano, porque a
  // redação muda com o tempo e o que vale é a que a pessoa leu.
  autorizacaoTexto String?   @map("autorizacao_texto")
  autorizacaoEm    DateTime? @map("autorizacao_em")

  // Motivo da recusa, escrito pelo admin na fila de aprovação (STORY-009,
  // frente B). Anulável: só a comunidade `recusada` tem. Fica no banco além
  // de ir no e-mail — pra auditar por que algo foi barrado sem depender da
  // caixa de e-mail de ninguém. Aprovar não preenche; recusar preenche.
  motivoRecusa String? @map("motivo_recusa")

  // Link de convite pra virar MEMBRO (nunca organizador — poder só entra
  // por convite nominal com aceite). Nulo = comunidade sem link ativo.
  codigoConvite String? @unique @map("codigo_convite")

  membros Membership[]

  @@index([organizationId])
  @@index([statusPublicacao])
  @@map("communities")
}

model Event {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  slug        String    @unique
  titulo      String
  startsAt    DateTime  @map("starts_at")
  city        String    @default("Brasília")
  local       String?
  capacidade  Int?
  gratuito    Boolean   @default(true)
  demo        Boolean   @default(false)
  ativo       Boolean   @default(true)
  // Cancelar NÃO apaga: existe gente inscrita, e apagar a linha some com o
  // histórico dela. Evento cancelado sai da descoberta, avisa os inscritos
  // por e-mail e não promove ninguém da fila (STORY-009, decisão 7).
  canceladoEm DateTime? @map("cancelado_em")
  rsvps       Rsvp[]

  @@index([communityId])
  @@index([startsAt])
  @@map("events")
}

enum RsvpStatus {
  confirmado
  lista_espera
}

model Rsvp {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now()) @map("created_at")
  eventId    String     @map("event_id")
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  nome       String
  email      String
  whatsapp   String?
  status     RsvpStatus @default(confirmado)
  // Vínculo opcional com conta (STORY-007). Continua existindo RSVP anônimo:
  // o `email` acima é a chave de reivindicação quando a pessoa cria conta.
  userId     String?    @map("user_id")
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Autoriza gerenciar a inscrição sem auth (STORY-003). Default no banco
  // (não no client) pra backfillar linhas existentes na própria migration.
  token      String     @unique @default(dbgenerated("(gen_random_uuid())::text"))
  canceledAt DateTime?  @map("canceled_at")
  // Check-in do organizador. Marcar duas vezes é o mesmo que marcar uma —
  // a idempotência mora aqui, não na UI, porque a tela é otimista e a rede
  // de quadra e parque cai no meio da lista.
  checkinEm  DateTime?  @map("checkin_em")

  @@unique([eventId, email])
  @@index([eventId])
  @@index([userId])
  @@map("rsvps")
}

// ─── AUTH (STORY-007) ──────────────────────────────────────────────────────
// Forma exigida pelo Better Auth 1.6.x. Os NOMES DAS PROPRIEDADES são
// contrato com a lib (o adapter chama prisma.user.create({ data: { emailVerified … } }));
// o @map das colunas é escolha nossa, pra manter snake_case como o resto.
// Conferido contra `getSchema()` do pacote instalado — não copiado de doc.

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]
  rsvps    Rsvp[]
  // Onde a pessoa TEM PODER (administra) e onde ela SÓ PERTENCE (segue).
  // São duas coisas diferentes de propósito — ver o comentário do
  // Membership lá embaixo.
  organizacoes OrganizationMember[]
  memberships  Membership[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Exigida pelo Better Auth mesmo sem OAuth e sem senha: no fluxo magic link
// ela fica praticamente vazia. Não remover — o core espera a tabela.
model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

// Tokens de magic link. Guardados com HASH (storeToken: "hashed" em lib/auth.ts):
// vazamento desta tabela não vira login de ninguém.
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── ORGANIZAÇÃO (STORY-009 · C4) ──────────────────────────────────────────
//
// A distinção que não pode borrar, e que decide a segurança do painel inteiro:
//
//   OrganizationMember = QUEM ADMINISTRA. Vê lista de inscritos, edita evento,
//   marca presença. Entra SÓ por convite nominal com aceite.
//
//   Membership         = QUEM SEGUE. Recebe aviso, aparece em "minhas
//   comunidades". Entra por link aberto, que o organizador joga no grupo.
//
// Se um dia link aberto conceder poder administrativo, qualquer pessoa com o
// link vê nome, e-mail e WhatsApp de gente real. É esse o incidente que a
// separação evita.

enum StatusPublicacao {
  pendente
  aprovada
  recusada
}

/// O negócio do parceiro. Fina de propósito (STORY-009, decisão 3): serve
/// pra agrupar comunidades sob um dono quando o mesmo grupo tiver várias.
/// Sem CNPJ, sem endereço, sem logo, sem plano — isso é C6 e não tem cliente
/// pedindo. Existe agora porque separar depois exige migrar dado vivo.
model Organization {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  nome      String
  slug      String   @unique

  membros     OrganizationMember[]
  communities Community[]
  convites    OrganizationInvite[]

  @@map("organizations")
}

/// Poder administrativo. Todo membro da organização é organizador — papéis
/// internos ficaram fora de escopo por não ter demanda.
model OrganizationMember {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now()) @map("created_at")
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

/// Convite nominal pra virar organizador. Por e-mail e com aceite, nunca por
/// link aberto: é isto que separa "entrou no grupo" de "pode ver a base de
/// participantes". Organização real raramente tem uma pessoa só, e sem isto
/// o painel morre no dia em que o dono tira férias.
model OrganizationInvite {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now()) @map("created_at")
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Guardado em minúsculas — o aceite compara com o e-mail da sessão.
  email          String
  token          String    @unique
  expiraEm       DateTime  @map("expira_em")
  aceitoEm       DateTime? @map("aceito_em")
  /// Quem convidou, pra auditoria de quem deu poder a quem.
  convidadoPorId String?   @map("convidado_por_id")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("organization_invites")
}

/// Papel numa comunidade (STORY-008, decisão 3). Nasce `membro`; só o /admin
/// (e a STORY-009) promove a `organizador`. O campo existe desde já pra 009
/// não precisar de migration de alteração.
enum PapelMembership {
  membro
  organizador
}

/// Pertencimento (STORY-008 · C3): a pessoa segue a comunidade. Um verbo só —
/// Seguir —, auto-serviço, sem aprovação. É o que faz "minhas comunidades" e a
/// agenda existirem sem precisar de grafo de amizade nenhum.
model Membership {
  id          String          @id @default(uuid())
  createdAt   DateTime        @default(now()) @map("created_at")
  userId      String          @map("user_id")
  communityId String          @map("community_id")
  papel       PapelMembership @default(membro)
  // Opt-out do aviso de evento novo. Default true (decisão 5): seguir cria
  // expectativa de ser avisado, então o aviso nasce ligado, com descadastro.
  avisarEventos Boolean       @default(true) @map("avisar_eventos")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
  @@map("memberships")
}
