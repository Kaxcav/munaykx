generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadTipo {
  participante
  organizador
}

model Lead {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  tipo        LeadTipo
  nome        String
  email       String
  whatsapp    String?
  modalidades String?
  regiao      String?
  organizacao String?
  modalidade  String?
  origem      String   @default("site")

  @@unique([email, tipo])
  @@map("leads")
}

model Community {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @map("created_at")
  slug       String   @unique
  nome       String
  modalidade String
  regiao     String
  // Multi-cidade no dado, não no código (Blueprint C1). Sem UI de seletor
  // ainda — as queries de descoberta filtram pelo default.
  city       String   @default("Brasília")
  descricao  String?
  horarios   String?
  local      String?
  nivel      String?
  // Sinal EXPLÍCITO do organizador: "essa comunidade acolhe quem tá começando".
  // Diferente de `nivel` (texto editorial livre) — este é estruturado/queryável, o
  // que sustenta o filtro `/comunidades?iniciantes=1` e o selo. Default false: quem
  // não marcou não aparece como acolhedor (sinal opt-in, nunca presumido).
  acolheIniciante Boolean @default(false) @map("acolhe_iniciante")
  // Guia de PRIMEIRA VEZ — a dor central da tese ("atravessar a porta") virando
  // interface, e o braço de produto do princípio de segurança (o organizador
  // como anfitrião: "ponto de encontro é a portaria e eu espero até as 6h").
  // COMPÕE com `acolheIniciante`: aquele é o sinal queryável e o selo; este é o
  // conteúdo que APARECE para o estreante. JSON com chaves FECHADAS validadas no
  // código (lib/guia.ts), mesmo padrão de `User.respostas` — chave nova não vira
  // migration. `null` = sem guia. Ver ULTRAPLAN-SOCIAL-ORGANIZADOR.md §6.3.
  guiaIniciante Json? @map("guia_iniciante")
  demo       Boolean  @default(false)
  ativo      Boolean  @default(true)
  events     Event[]

  // ── Organização dona (STORY-009) ─────────────────────────────────────
  // `null` = cadastrada por nós pelo /admin. Continua existindo e sendo
  // editável só pelo admin interno.
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Default `aprovada` DE PROPÓSITO, não `pendente`: as comunidades que já
  // estão em produção foram cadastradas por nós e não podem sumir do site
  // no instante do deploy. Quem nasce pendente é só o que vem pelo painel,
  // e isso é decidido na aplicação — nunca no default da coluna.
  statusPublicacao StatusPublicacao @default(aprovada) @map("status_publicacao")

  // A PROVA da regra 3 do projeto: o texto exato que o organizador aceitou
  // e quando. Não é telemetria — é o documento que autoriza publicar o nome
  // de um parceiro real. Guardar o texto, e não só um booleano, porque a
  // redação muda com o tempo e o que vale é a que a pessoa leu.
  autorizacaoTexto String?   @map("autorizacao_texto")
  autorizacaoEm    DateTime? @map("autorizacao_em")

  // Motivo da recusa, escrito pelo admin na fila de aprovação (STORY-009,
  // frente B). Anulável: só a comunidade `recusada` tem. Fica no banco além
  // de ir no e-mail — pra auditar por que algo foi barrado sem depender da
  // caixa de e-mail de ninguém. Aprovar não preenche; recusar preenche.
  motivoRecusa String? @map("motivo_recusa")

  // Link de convite pra virar MEMBRO (nunca organizador — poder só entra
  // por convite nominal com aceite). Nulo = comunidade sem link ativo.
  codigoConvite String? @unique @map("codigo_convite")

  membros Membership[]
  posts   Post[]
  // O eixo de tempo (FASE 0 do mapa). `horarios` acima continua sendo o texto
  // livre que a pessoa escreve e o site mostra; ISTO é a versão consultável.
  // Os dois convivem de propósito — ver `lib/horarios.ts`.
  horariosRecorrentes HorarioRecorrente[]

  @@index([organizationId])
  @@index([statusPublicacao])
  @@map("communities")
}

/**
 * HORÁRIO RECORRENTE — o destravador do eixo de tempo (FASE 0 do mapa).
 *
 * O PROBLEMA: `Community.horarios` é texto livre ("toda terça e quinta, 6h15").
 * Texto não se consulta. Não dá pra perguntar ao banco "o que está ativo terça
 * às 6h" — e essa pergunta é o diferencial do produto. Esta tabela existe para
 * tornar a recorrência CONSULTÁVEL, e é a razão de a Fase 0 vir antes de
 * qualquer mapa cartográfico.
 *
 * O texto livre NÃO foi removido e não deve ser: ele carrega nuance que
 * nenhum campo estruturado carrega ("6h15, exceto feriado, ponto de encontro no
 * portão 3"). O estruturado alimenta o mapa; o texto continua sendo o que a
 * pessoa lê. Comunidade sem horário estruturado simplesmente não responde ao
 * scrubber — degrada, não quebra.
 *
 * MINUTOS, e não "hora": 6h15 é o horário real de treino de corrida. Guardar
 * hora inteira perderia o dado logo no caso mais comum. Minutos desde 00:00
 * (6h15 = 375) comparam com `>=`/`<=` sem parsing e indexam como inteiro.
 *
 * SEM lat/lng DE PROPÓSITO (Fase 1, atrás de decisão de privacidade): o mapa
 * da Fase 0 acende REGIÃO, nunca ponto. É isso que zera o risco de expor "onde
 * tem gente treinando sozinha às 6h" — o filtro que a própria Strava se recusou
 * a entregar. Ver PESQUISA-MAPA-MUNAY.md §H.
 */
model HorarioRecorrente {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  communityId String    @map("community_id")
  // Cascade: horário sem comunidade não significa nada. Apagou a comunidade,
  // os horários vão junto — nada de linha órfã acendendo o mapa.
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  /// 0=domingo … 6=sábado. Mesma convenção do `Date.getDay()` do JS, pra não
  /// precisar de tradução na fronteira (que é onde erro de fuso nasce).
  diaSemana Int @map("dia_semana")

  /// Minutos desde 00:00 (6h15 = 375).
  minutoInicio Int @map("minuto_inicio")

  /// Fim, também em minutos. Anulável: muita comunidade sabe a hora que começa
  /// e não a que termina. `null` → o cálculo assume a duração padrão
  /// (`DURACAO_PADRAO_MIN` em `lib/horarios.ts`), em vez de sumir do mapa.
  minutoFim Int? @map("minuto_fim")

  /// RA da OCORRÊNCIA, quando ela difere da RA da comunidade (grupo itinerante
  /// que treina no Parque da Cidade na terça e no Guará no sábado). `null` = usa
  /// a região da comunidade, que é o caso comum. Nasce anulável para NÃO
  /// duplicar o dado da `Community` por padrão — duas cópias divergem em
  /// silêncio, e a que estivesse errada acenderia a RA errada no mapa.
  regiao String?

  /// Pausar o horário sem perder o registro (recesso, obra na quadra). Igual ao
  /// `ativo` da comunidade: é do organizador, não da MUNAY.
  ativo Boolean @default(true)

  /// Exceções pontuais desta grade (a "sexta chuvosa"): um dia cancelado ou com
  /// local/hora alterados, sem mexer no padrão semanal.
  excecoes ExcecaoHorario[]

  /// Eventos que materializaram UMA ocorrência desta grade (via "marcar o
  /// próximo treino", PR3). Serve pra deduplicar a home: a ocorrência que já
  /// virou evento não aparece de novo como sugestão.
  ocorrencias Event[]

  // O índice do eixo de tempo: a consulta central é sempre por (dia, minuto).
  @@index([diaSemana, minutoInicio])
  @@index([communityId])
  @@map("horarios_recorrentes")
}

/// EXCEÇÃO DE OCORRÊNCIA (Frente 1 · ULTRAPLAN-SOCIAL-ORGANIZADOR.md §6.4).
///
/// A "sexta chuvosa": cancelar ou alterar UM encontro específico da grade sem
/// tocar no padrão semanal. Padrão iCal `EXDATE`/override — a grade
/// (`HorarioRecorrente`) é o `RRULE`, esta tabela é a exceção pontual.
///
/// Cascade: exceção sem a grade não significa nada. Anulável só onde a alteração
/// é opcional (mudou o local mas não a hora). Uma exceção por (grade, dia): o
/// `@@unique` impede dois registros para o mesmo encontro, e o upsert grava um
/// só. NÃO afeta o mapa semanal (bitmask por dia-da-semana) — exceção é de uma
/// DATA, não do padrão; ela filtra só a lista de PRÓXIMAS ocorrências concretas.
model ExcecaoHorario {
  id                  String   @id @default(uuid())
  createdAt           DateTime @default(now()) @map("created_at")
  horarioRecorrenteId String   @map("horario_recorrente_id")
  horarioRecorrente   HorarioRecorrente @relation(fields: [horarioRecorrenteId], references: [id], onDelete: Cascade)

  /// A DATA da ocorrência afetada. `@db.Date` (só calendário — a grade já diz a
  /// hora). Guardada como meia-noite UTC do dia, igual a `User.nascimento`.
  data DateTime @db.Date

  /// Cancelou o encontro daquele dia? `false` com algum campo alterado = mudou,
  /// não cancelou.
  cancelada Boolean @default(false)

  /// Override leve SEM virar Event: mudou o local só naquele dia ("hoje a saída
  /// é do outro portão"). `null` = herda o local da comunidade.
  localAlterado String? @map("local_alterado")

  /// Hora de início alterada só naquele dia, em minutos desde 00:00 (mesma
  /// convenção do `minutoInicio`). `null` = herda a hora da grade.
  minutoInicioAlterado Int? @map("minuto_inicio_alterado")

  /// Nota curta que aparece pra quem for ("hoje começa 15 min mais tarde").
  observacao String?

  @@unique([horarioRecorrenteId, data])
  @@index([data])
  @@map("excecoes_horario")
}

model Event {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  slug        String    @unique
  titulo      String
  startsAt    DateTime  @map("starts_at")
  // Fim do encontro. Anulável no MESMO espírito do `minutoFim` da recorrência
  // (`HorarioRecorrente`): muita comunidade sabe a hora que começa e não a que
  // termina. `null` → o cálculo assume `DURACAO_PADRAO_MIN` (lib/horarios.ts),
  // em vez de sumir do eixo de tempo. É o pré-requisito de saber o que está
  // ACONTECENDO às 6h30, não só o que começa às 6h. Guardo o INSTANTE (não a
  // duração em minutos) para espelhar `minutoInicio`+`minutoFim` do horário
  // recorrente — a mesma pergunta ("acontece em T?") vira um range simples
  // `startsAt <= T AND (terminaEm ?? startsAt+padrão) > T`. O formulário coleta
  // duração e a escrita compõe `terminaEm = startsAt + duração` (sem drift: a
  // duração volta a cada save). [caro depois]: trocar para duracao_min exigiria
  // migrar o dado, não só a coluna.
  terminaEm   DateTime? @map("termina_em")
  // Grade que originou este evento ("marcar o próximo treino", PR3). `null` =
  // evento avulso. `SetNull`: apagar a grade não apaga o evento já publicado —
  // ele existe por si, o vínculo é só proveniência.
  horarioRecorrenteId String? @map("horario_recorrente_id")
  horarioRecorrente   HorarioRecorrente? @relation(fields: [horarioRecorrenteId], references: [id], onDelete: SetNull)
  city        String    @default("Brasília")
  local       String?
  // MODO ROTA (pedal/corrida/trilha): o encontro tem SAÍDA e CHEGADA, não um
  // ponto só. `origem`/`destino` são TEXTO — nunca lat/lng, geojson ou linha no
  // mapa. Coordenada é Fase 1+ do mapa e depende da decisão de privacidade (D6),
  // pela mesma razão que o `HorarioRecorrente` recusou lat/lng: rota exata +
  // horário é rastro. Anuláveis: quando `modoRota=false`, `local` manda como
  // hoje e estes ficam null; quando true, `local` é null e estes valem.
  modoRota    Boolean   @default(false) @map("modo_rota")
  origem      String?
  destino     String?
  percursoObs String?   @map("percurso_obs")
  capacidade  Int?
  gratuito    Boolean   @default(true)
  demo        Boolean   @default(false)
  ativo       Boolean   @default(true)
  // Cancelar NÃO apaga: existe gente inscrita, e apagar a linha some com o
  // histórico dela. Evento cancelado sai da descoberta, avisa os inscritos
  // por e-mail e não promove ninguém da fila (STORY-009, decisão 7).
  canceladoEm DateTime? @map("cancelado_em")
  rsvps       Rsvp[]

  @@index([communityId])
  @@index([startsAt])
  @@index([horarioRecorrenteId])
  @@map("events")
}

enum RsvpStatus {
  confirmado
  lista_espera
}

model Rsvp {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now()) @map("created_at")
  eventId    String     @map("event_id")
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  nome       String
  email      String
  whatsapp   String?
  status     RsvpStatus @default(confirmado)
  // Vínculo opcional com conta (STORY-007). Continua existindo RSVP anônimo:
  // o `email` acima é a chave de reivindicação quando a pessoa cria conta.
  userId     String?    @map("user_id")
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Autoriza gerenciar a inscrição sem auth (STORY-003). Default no banco
  // (não no client) pra backfillar linhas existentes na própria migration.
  token      String     @unique @default(dbgenerated("(gen_random_uuid())::text"))
  canceledAt DateTime?  @map("canceled_at")
  // Idempotência do lembrete de véspera ("O que esperar", 1 dia antes). O cron
  // reivindica de forma ATÔMICA (updateMany condicional em `avisadoVesperaEm`),
  // então rodar o job duas vezes no mesmo dia — ou dois processos em corrida —
  // manda UM e-mail por inscrito, nunca dois. `null` = ainda não avisado.
  avisadoVesperaEm DateTime? @map("avisado_vespera_em")
  // Check-in do organizador. Marcar duas vezes é o mesmo que marcar uma —
  // a idempotência mora aqui, não na UI, porque a tela é otimista e a rede
  // de quadra e parque cai no meio da lista.
  checkinEm  DateTime?  @map("checkin_em")

  @@unique([eventId, email])
  @@index([eventId])
  @@index([userId])
  @@map("rsvps")
}

// ─── AUTH (STORY-007) ──────────────────────────────────────────────────────
// Forma exigida pelo Better Auth 1.6.x. Os NOMES DAS PROPRIEDADES são
// contrato com a lib (o adapter chama prisma.user.create({ data: { emailVerified … } }));
// o @map das colunas é escolha nossa, pra manter snake_case como o resto.
// Conferido contra `getSchema()` do pacote instalado — não copiado de doc.

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // ─── PERFIL (STORY-011, briefing do PO de 07/08/2026) ─────────────────
  // TODOS OPCIONAIS, e isso é decisão, não preguiça. O RSVP funciona sem
  // conta e a conta funciona sem perfil: campo obrigatório aqui viraria
  // barreira no meio do funil, contra a regra "auth é aditiva, nunca
  // barreira" da STORY-007.

  // 8.1 · Dados cadastrais.
  //
  // ⚠️ NÃO EXISTE CAMPO DE CPF AQUI, E A AUSÊNCIA É A DECISÃO.
  // O briefing pedia CPF (item 8.1) e ele chegou a ser escrito. Saiu em
  // 07/08/2026, por decisão do Kaxcav, com três motivos:
  //   1. A finalidade declarada na tela era "vai fazer falta quando existir
  //      ingresso pago e nominal" — ou seja, o dado mais sensível do projeto
  //      para uma funcionalidade que NÃO EXISTE (é C6, pós-tração).
  //   2. A política de privacidade não menciona CPF. Coletar sem o texto
  //      correspondente é o buraco de LGPD, não o campo em si.
  //   3. O `@unique` prevenia fraude hipotética (não há pagamento) e em troca
  //      criava enumeração: dava pra descobrir se um CPF está cadastrado.
  // Se um dia voltar, volta junto com C6, com finalidade real e política
  // reescrita. Não reintroduza "porque é fácil".
  nascimento    DateTime? @db.Date
  // Gênero AUTODECLARADO, texto livre com sugestões na UI. O briefing pedia
  // "sexo e gênero" em campos separados; só gênero foi implementado —
  // DESVIO CONFESSADO, racional na STORY-011 (sexo biológico não tem uso
  // no produto, e dado sensível sem finalidade é passivo de LGPD, não ativo).
  genero        String?
  cidade        String?
  uf            String?   @db.Char(2)
  cep           String?   @db.VarChar(9)
  telefone      String?

  // 11 · Camada pública — o que a comunidade vê.
  apelido       String?
  bio           String?
  fotoUrl       String?   @map("foto_url")
  // Opt-in explícito: perfil nasce PRIVADO. Quem preenche bio não está
  // pedindo pra ser listado.
  perfilPublico Boolean   @default(false) @map("perfil_publico")

  // 11.1 · Tags de interesse (padrão de app de relacionamento, pedido do PO).
  // Lista escalar em vez de tabela de junção: o catálogo é fechado
  // (lib/interesses.ts) e ninguém precisa consultar "quem gosta de X" ainda.
  // Vira tabela própria quando existir busca por interesse — ONDA 2.
  interesses    String[]  @default([])

  // 8.2 · Camada de personalidade — as perguntas leves.
  // JSONB de chave → resposta. O catálogo de perguntas vive no código
  // (lib/perfil-perguntas.ts), não no banco: pergunta some, dado antigo
  // continua legível. Consultável por `respostas->>'chave'` quando o PO
  // quiser cruzar.
  respostas     Json?

  // 10 · CONSENTIMENTO GRANULAR (LGPD). Três finalidades separadas porque
  // são três decisões diferentes, e a lei não aceita consentimento em
  // bloco pra finalidades distintas. Guardado como DATA (não boolean):
  // "quando consentiu" é o que se prova numa fiscalização; boolean só diz
  // "sim" e não diz desde quando nem contra qual versão da política.
  consentiuCadastro      DateTime? @map("consentiu_cadastro")
  consentiuRecomendacao  DateTime? @map("consentiu_recomendacao")
  consentiuInsights      DateTime? @map("consentiu_insights")
  // Versão da política vigente no aceite — sem isso, mudar a política
  // apaga a prova de que a pessoa consentiu com a versão anterior.
  politicaVersao         String?   @map("politica_versao")

  sessions Session[]
  accounts Account[]
  rsvps    Rsvp[]
  // Onde a pessoa TEM PODER (administra) e onde ela SÓ PERTENCE (segue).
  // São duas coisas diferentes de propósito — ver o comentário do
  // Membership lá embaixo.
  organizacoes OrganizationMember[]
  memberships  Membership[]
  // Avisos publicados. Sem cascade: apagar a conta anonimiza o aviso
  // (`autorId` vira null), não apaga o histórico da comunidade — ver Post.
  posts        Post[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Exigida pelo Better Auth mesmo sem OAuth e sem senha: no fluxo magic link
// ela fica praticamente vazia. Não remover — o core espera a tabela.
model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

// Tokens de magic link. Guardados com HASH (storeToken: "hashed" em lib/auth.ts):
// vazamento desta tabela não vira login de ninguém.
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── ORGANIZAÇÃO (STORY-009 · C4) ──────────────────────────────────────────
//
// A distinção que não pode borrar, e que decide a segurança do painel inteiro:
//
//   OrganizationMember = QUEM ADMINISTRA. Vê lista de inscritos, edita evento,
//   marca presença. Entra SÓ por convite nominal com aceite.
//
//   Membership         = QUEM SEGUE. Recebe aviso, aparece em "minhas
//   comunidades". Entra por link aberto, que o organizador joga no grupo.
//
// Se um dia link aberto conceder poder administrativo, qualquer pessoa com o
// link vê nome, e-mail e WhatsApp de gente real. É esse o incidente que a
// separação evita.

enum StatusPublicacao {
  pendente
  aprovada
  recusada
}

/// O negócio do parceiro. Fina de propósito (STORY-009, decisão 3): serve
/// pra agrupar comunidades sob um dono quando o mesmo grupo tiver várias.
/// Sem CNPJ, sem endereço, sem logo, sem plano — isso é C6 e não tem cliente
/// pedindo. Existe agora porque separar depois exige migrar dado vivo.
model Organization {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  nome      String
  slug      String   @unique

  membros     OrganizationMember[]
  communities Community[]
  convites    OrganizationInvite[]

  @@map("organizations")
}

/// Poder administrativo. Todo membro da organização é organizador — papéis
/// internos ficaram fora de escopo por não ter demanda.
model OrganizationMember {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now()) @map("created_at")
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

/// Convite nominal pra virar organizador. Por e-mail e com aceite, nunca por
/// link aberto: é isto que separa "entrou no grupo" de "pode ver a base de
/// participantes". Organização real raramente tem uma pessoa só, e sem isto
/// o painel morre no dia em que o dono tira férias.
model OrganizationInvite {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now()) @map("created_at")
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Guardado em minúsculas — o aceite compara com o e-mail da sessão.
  email          String
  token          String    @unique
  expiraEm       DateTime  @map("expira_em")
  aceitoEm       DateTime? @map("aceito_em")
  /// Quem convidou, pra auditoria de quem deu poder a quem.
  convidadoPorId String?   @map("convidado_por_id")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("organization_invites")
}

/// Papel numa comunidade (STORY-008, decisão 3). Nasce `membro`; só o /admin
/// (e a STORY-009) promove a `organizador`. O campo existe desde já pra 009
/// não precisar de migration de alteração.
enum PapelMembership {
  membro
  organizador
}

/// Pertencimento (STORY-008 · C3): a pessoa segue a comunidade. Um verbo só —
/// Seguir —, auto-serviço, sem aprovação. É o que faz "minhas comunidades" e a
/// agenda existirem sem precisar de grafo de amizade nenhum.
model Membership {
  id          String          @id @default(uuid())
  createdAt   DateTime        @default(now()) @map("created_at")
  userId      String          @map("user_id")
  communityId String          @map("community_id")
  papel       PapelMembership @default(membro)
  // Opt-out do aviso de evento novo. Default true (decisão 5): seguir cria
  // expectativa de ser avisado, então o aviso nasce ligado, com descadastro.
  avisarEventos Boolean       @default(true) @map("avisar_eventos")
  // Teto "1 aviso por comunidade por dia por pessoa". É o gate atômico: um
  // updateMany condicional em `ultimoAvisoEm` decide quem recebe, então dois
  // eventos no mesmo dia (mesmo em corrida) só geram UM e-mail por seguidor.
  ultimoAvisoEm DateTime?     @map("ultimo_aviso_em")
  // Aviso de POST é OPT-IN (STORY-010, decisão 4) — nasce DESLIGADO, ao
  // contrário do de evento. Regra: e-mail que a pessoa espera vem ligado;
  // e-mail que ela não pediu vem desligado. Inverter isso é como se queima a
  // reputação de um domínio recém-aquecido.
  avisarPosts   Boolean       @default(false) @map("avisar_posts")
  // Teto de post, SEPARADO do de evento: um não pode consumir a cota do
  // outro. Mesmo gate atômico (updateMany condicional).
  ultimoAvisoPostEm DateTime? @map("ultimo_aviso_post_em")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
  @@map("memberships")
}

/// Feed de avisos da comunidade (STORY-010 · C5). É o aviso curto e
/// situacional — "hoje o treino é no campo 2" — que hoje só existe no grupo de
/// WhatsApp, justamente onde o iniciante que a MUNAY trouxe não está.
///
/// One-way de propósito: não tem comentário (decisão 2 — comentário é fórum
/// com outro nome, e fórum sem moderador é passivo, não ativo).
model Post {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  communityId String    @map("community_id")
  // NULLABLE com `SetNull` — e isto é um desvio consciente da spec, que pedia
  // autor obrigatório "sem Cascade". Sem nulo, apagar a conta seria impossível
  // (FK) ou levaria o histórico junto; com `SetNull`, apagar a conta anonimiza
  // o aviso e preserva o que a comunidade recebeu. É a resolução do conflito
  // que a própria spec apontou entre histórico e "apagar conta apaga tudo" da
  // LGPD: **anonimizar, não deletar** — sem job, sem varredura, estrutural.
  autorId     String?   @map("autor_id")
  corpo       String    @db.Text
  // Moderação (decisão 6): ocultar é reversível, apagar não. Existe pro caso
  // de alguém publicar dado pessoal de terceiro às 3h de um sábado.
  ocultoEm     DateTime? @map("oculto_em")
  ocultoMotivo String?   @map("oculto_motivo")
  // Quem ocultou. O /admin é Basic Auth compartilhado, então o que dá pra
  // registrar honestamente é o usuário daquela credencial — não uma pessoa.
  ocultoPor    String?   @map("oculto_por")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  autor     User?     @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([communityId, createdAt])
  @@map("posts")
}

/// CONTEÚDO EDITÁVEL PELO /admin (ULTRAPLAN, Onda 1).
///
/// Key-value de propósito, com o SCHEMA no código (`lib/conteudo/registro.ts`,
/// Zod por chave). Tabela por seção faria cada ajuste de copy virar migration
/// — e migration é deploy, que é exatamente o que esta onda existe pra evitar.
///
/// O código continua dono da ESTRUTURA; o banco guarda só o VALOR. Chave que
/// não está no registro é ignorada na leitura, e chave sem linha aqui cai no
/// padrão do registro — que é o texto que já estava hardcoded. Por isso o site
/// sobe idêntico ao de hoje com esta tabela vazia, e continua de pé se o banco
/// sumir (mesma regra do "sem DATABASE_URL o site sobe").
model ConteudoSite {
  chave         String   @id
  valor         Json
  /// Formato do `valor` quando foi gravado. Se o registro mudar de formato, a
  /// leitura valida com Zod e cai no padrão em vez de lançar.
  versaoSchema  Int      @default(1) @map("versao_schema")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  /// Credencial do /admin (Basic Auth é compartilhada — é a identidade que
  /// existe de verdade; inventar nome de pessoa aqui seria registro falso).
  atualizadoPor String   @map("atualizado_por")

  @@map("conteudo_site")
}

/// Histórico APPEND-ONLY: é o audit log e o rollback ao mesmo tempo.
///
/// Nada aqui é editado ou apagado pela interface. Reverter cria um registro
/// novo apontando o valor antigo — mesma regra do "ocultar é reversível,
/// apagar não" da STORY-010.
///
/// ⚠️ LGPD: `valor` pode conter dado pessoal (contato de fundador), então esta
/// tabela tem o mesmo acesso restrito do resto do /admin e não vai pra
/// exportação nenhuma.
model ConteudoVersao {
  id           String    @id @default(uuid())
  chave        String
  valor        Json
  versaoSchema Int       @default(1) @map("versao_schema")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  criadoPor    String    @map("criado_por")
  /// `null` = rascunho. Publicar carimba aqui e copia o valor pro ConteudoSite.
  publicadoEm  DateTime? @map("publicado_em")

  @@index([chave, criadoEm])
  @@map("conteudo_versoes")
}

/// REGISTRO ANÔNIMO DE BUSCAS — o "gravador" (enabler da ideia #5).
///
/// Guarda o que a cidade PROCURA, para um dia responder "o que Brasília pede
/// e a MUNAY ainda não tem". Autorizado pelo dono em 09/08/2026.
///
/// ── ANONIMATO ESTRUTURAL, NÃO POR DISCIPLINA ────────────────────────────
///
/// Esta tabela **não tem relation com User, não tem IP e não tem sessão**, e
/// isso é a garantia: não existe coluna por onde ligar uma busca a uma pessoa,
/// então nenhum código futuro consegue fazer essa ligação por engano. Nem hash
/// de IP — hash de IP continua sendo pseudônimo, e pseudônimo identifica.
///
/// ⚠️ **`texto` é DADO SENSÍVEL.** Gente escreve desabafo em campo de busca
/// ("quero voltar a treinar depois da depressão"). O texto fica porque é o
/// valor do registro, mas com três travas: nunca é exibido individualmente no
/// /admin (só contagem), nunca sai em export, e o uso previsto é agregado.
/// Retenção proposta: 12 meses (a confirmar com o jurídico, junto do resto da
/// política).
model BuscaRegistro {
  id        String   @id @default(uuid())
  /// Só a data — sem hora. Hora + região aproximada começa a virar rastro de
  /// uma pessoa específica num bairro pequeno.
  dia       DateTime @db.Date
  /// O que a pessoa escreveu, cortado. Sensível — ver o aviso acima.
  /// NULL depois da purga de retenção (12 meses, ver lib/ai/retencao.ts): o
  /// texto some, a linha fica. Anulável por isso, não porque seja opcional na
  /// gravação.
  texto     String?  @db.Text
  /// O que a IA ENTENDEU. `null` quando não deu pra interpretar — e esse null
  /// é informação: é a busca que o produto não soube atender.
  modalidade String?
  /// Região aproximada: a que a busca mencionou, não a de quem buscou. A
  /// MUNAY não geolocaliza ninguém.
  regiao     String?
  /// Houve comunidade pra oferecer? `false` é o registro mais valioso: é
  /// demanda existindo sem oferta.
  teveResultado Boolean @default(false) @map("teve_resultado")

  @@index([dia])
  @@map("busca_registros")
}

/// "A SEMANA EM BRASÍLIA" — curadoria semanal (ideia #3).
///
/// Um resumo em texto dos eventos da próxima semana, gerado uma vez por
/// semana e servido em `/semana`. Guardado em vez de gerado por request por
/// três motivos: o texto é o mesmo pra todo mundo, gerar por visita
/// multiplicaria o custo por visitante, e uma página de SEO não pode depender
/// de a API estar de pé no instante do crawler.
///
/// Append-only na prática: cada geração cria uma linha, e a página lê a mais
/// recente. O histórico fica — dá pra ver o que a cidade tinha em cada semana.
model ResumoSemana {
  id        String   @id @default(uuid())
  criadoEm  DateTime @default(now()) @map("criado_em")
  /// Primeiro dia da janela coberta. Único: uma semana, um resumo vigente.
  inicio    DateTime @db.Date
  /// O texto pronto pra colar no Instagram.
  texto     String   @db.Text
  /// Quantos eventos reais entraram. `0` nunca chega a virar linha — sem
  /// evento não há curadoria, e a página mostra estado vazio.
  eventos   Int

  @@index([inicio])
  @@map("resumos_semana")
}
