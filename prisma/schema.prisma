generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadTipo {
  participante
  organizador
}

model Lead {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  tipo        LeadTipo
  nome        String
  email       String
  whatsapp    String?
  modalidades String?
  regiao      String?
  organizacao String?
  modalidade  String?
  origem      String   @default("site")

  @@unique([email, tipo])
  @@map("leads")
}

model Community {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @map("created_at")
  slug       String   @unique
  nome       String
  modalidade String
  regiao     String
  // Multi-cidade no dado, não no código (Blueprint C1). Sem UI de seletor
  // ainda — as queries de descoberta filtram pelo default.
  city       String   @default("Brasília")
  descricao  String?
  horarios   String?
  local      String?
  nivel      String?
  demo       Boolean  @default(false)
  ativo      Boolean  @default(true)
  events     Event[]

  @@map("communities")
}

model Event {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  slug        String    @unique
  titulo      String
  startsAt    DateTime  @map("starts_at")
  city        String    @default("Brasília")
  local       String?
  capacidade  Int?
  gratuito    Boolean   @default(true)
  demo        Boolean   @default(false)
  ativo       Boolean   @default(true)
  rsvps       Rsvp[]

  @@index([communityId])
  @@index([startsAt])
  @@map("events")
}

enum RsvpStatus {
  confirmado
  lista_espera
}

model Rsvp {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now()) @map("created_at")
  eventId    String     @map("event_id")
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  nome       String
  email      String
  whatsapp   String?
  status     RsvpStatus @default(confirmado)
  // Vínculo opcional com conta (STORY-007). Continua existindo RSVP anônimo:
  // o `email` acima é a chave de reivindicação quando a pessoa cria conta.
  userId     String?    @map("user_id")
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Autoriza gerenciar a inscrição sem auth (STORY-003). Default no banco
  // (não no client) pra backfillar linhas existentes na própria migration.
  token      String     @unique @default(dbgenerated("(gen_random_uuid())::text"))
  canceledAt DateTime?  @map("canceled_at")

  @@unique([eventId, email])
  @@index([eventId])
  @@index([userId])
  @@map("rsvps")
}

// ─── AUTH (STORY-007) ──────────────────────────────────────────────────────
// Forma exigida pelo Better Auth 1.6.x. Os NOMES DAS PROPRIEDADES são
// contrato com a lib (o adapter chama prisma.user.create({ data: { emailVerified … } }));
// o @map das colunas é escolha nossa, pra manter snake_case como o resto.
// Conferido contra `getSchema()` do pacote instalado — não copiado de doc.

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]
  rsvps    Rsvp[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Exigida pelo Better Auth mesmo sem OAuth e sem senha: no fluxo magic link
// ela fica praticamente vazia. Não remover — o core espera a tabela.
model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

// Tokens de magic link. Guardados com HASH (storeToken: "hashed" em lib/auth.ts):
// vazamento desta tabela não vira login de ninguém.
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
